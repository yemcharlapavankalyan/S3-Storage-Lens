{
  "name": "s3-storage-optimizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm --prefix backend test",
    "preview": "vite preview",
    "backend": "node backend/src/server.js",
    "backend:dev": "npm --prefix backend run dev",
    "backend:test": "npm --prefix backend test",
    "demo-data:dry-run": "node backend/scripts/demoData.js dry-run",
    "demo-data:upload": "node backend/scripts/demoData.js upload",
    "demo-data:verify": "node backend/scripts/demoData.js verify",
    "demo-data:cleanup": "node backend/scripts/demoData.js cleanup",
    "demo-data:activity": "node backend/scripts/demoData.js activity",
    "demo-data:test": "node backend/tests/demoData.test.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
